extends Control
## Credits and thanks. Also shows the final tally after the ending.

func _ready() -> void:
	theme = UITheme.theme()
	AudioService.music("ending")
	var bg := ColorRect.new()
	bg.color = Color("fdf2e0")
	bg.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	add_child(bg)
	var tato := TextureRect.new()
	tato.texture = Art.tex("tato_big/cheer")
	tato.set_anchors_and_offsets_preset(Control.PRESET_CENTER_LEFT)
	tato.offset_left = 70.0
	tato.offset_top = -170.0
	tato.offset_right = 410.0
	tato.offset_bottom = 200.0
	tato.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	tato.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	tato.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(tato)
	var box := VBoxContainer.new()
	box.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	box.offset_left = 440.0
	box.offset_right = -60.0
	box.offset_top = 30.0
	box.offset_bottom = -30.0
	box.add_theme_constant_override("separation", 8)
	add_child(box)
	box.add_child(UITheme.title_label("TATO!", 64))
	var sub := UITheme.label("A Little Goose With a Big Appetite", 26, UITheme.PLUM, true)
	sub.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(sub)
	var lines := [
		"Game idea, characters, worlds and all artwork direction: the TATO! family",
		"Character and world illustrations: made with the family's image tool from their own designs",
		"Game programming, stage building, sound and music: built with Claude",
		"Engine: Godot Engine 4 (MIT licence)",
		"Font: Fredoka, The Fredoka Project Authors (SIL Open Font Licence 1.1)",
		"Sound effects and music: made for this game (generated by tools/audio)",
		"",
		"Thank you for playing! HONK!",
	]
	if GameState.profile.get("game_complete", false):
		lines.insert(0, "")
		lines.insert(0, "Your feast: %d of %d stars, %d of %d Treasure Notes, %d Flavor Bursts, %d%% complete" % [
			GameState.count("star"), LevelDB.star_total(), GameState.count("note"), LevelDB.note_total(),
			GameState.bursts_found(), int(GameState.completion() * 100.0)])
	for line: String in lines:
		var l := UITheme.label(line, 22)
		l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		box.add_child(l)
	var spacer := Control.new()
	spacer.size_flags_vertical = Control.SIZE_EXPAND_FILL
	box.add_child(spacer)
	var back := UITheme.button("Back", Vector2(240, 60))
	back.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	back.pressed.connect(func() -> void:
		if GameState.slot >= 0 and GameState.is_cleared("W1-L1"):
			Game.goto_hub()
		else:
			Game.goto_title())
	box.add_child(back)
	back.grab_focus()
