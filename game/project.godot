; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TATO!"
config/description="A Little Goose With a Big Appetite"
config/version="0.3.0"
run/main_scene="res://scenes/boot/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.99, 0.95, 0.88, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/ui/boot_splash.png"
boot_splash/fullsize=false
config/icon="res://icon.svg"

[autoload]

Settings="*res://autoload/Settings.gd"
Controls="*res://autoload/Controls.gd"
SaveService="*res://autoload/SaveService.gd"
FoodDB="*res://autoload/FoodDB.gd"
LevelDB="*res://autoload/LevelDB.gd"
GameState="*res://autoload/GameState.gd"
AudioService="*res://autoload/AudioService.gd"
Captions="*res://autoload/Captions.gd"
Game="*res://autoload/Game.gd"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[debug]

gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/default_font_multichannel_signed_distance_field=false
common/snap_controls_to_pixels=true

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="interact"
2d_physics/layer_5="hazard"
2d_physics/layer_6="effect"
2d_physics/layer_7="prop"
2d_physics/layer_8="water"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
2d/default_gravity=1500.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.56, 0.8, 0.95, 1)
textures/canvas_textures/default_texture_filter=1
2d/snap/snap_2d_transforms_to_pixel=false
